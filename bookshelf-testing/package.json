{
  "name": "bookshelf-playwright-tests",
  "version": "1.0.0",
  "description": "Playwright black-box tests for Bookshelf CI4 application",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report test-results/playwright-report",
    "test:single": "playwright test --grep",
    "seed": "cd .. && php spark db:seed TestSeeder",
    "pretest": "cd .. && php spark db:seed TestSeeder"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0"
  }
}
